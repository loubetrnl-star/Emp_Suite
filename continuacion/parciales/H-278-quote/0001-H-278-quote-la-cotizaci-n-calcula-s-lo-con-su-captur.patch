+    aceptarCot("vent>quote");
+    const ev = (S.quote.entradas || {})["vent>quote"], vin = (S.vinculos || {})["vent>quote"];
+    if (!ev || !(ev.ts > 0) || !ev.firma || !ev.origen || !ev.datos) throw new Error("la copia aceptada lleva origen, fecha, firma y datos: " + JSON.stringify(ev));
+    if (!vin || vin.estado !== "aceptado") throw new Error("aceptar deja el vínculo registrado: " + JSON.stringify(vin));
