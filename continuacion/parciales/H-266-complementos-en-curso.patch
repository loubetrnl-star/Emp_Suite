+    Object.keys(G("LINKS")).forEach((k) => { S.perms[k] = { ts: 1, via: "S.131" }; });
+    const muebles = [{ id: "wc_flux", cant: 4 }, { id: "ming_flux", cant: 2 }, { id: "lavabo", cant: 4 }, { id: "fregadero", cant: 1 }, { id: "manguera", cant: 2 }];
