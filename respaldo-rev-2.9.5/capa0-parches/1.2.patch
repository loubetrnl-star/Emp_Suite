+    const A = AN(p);
+    contiene(todo, `el analisis desde insumos da ${nf(A.directo, 2)} y el catalogo de referencia trae ${nf(p.unit, 2)}.`, p.clave + " contraste a costo directo:");
+    contiene(todo, `Diferencia ${nf((A.directo / p.unit - 1) * 100, 1)} %`, p.clave + " diferencia al mismo nivel:");
+  });
+  const k = celdas.indexOf("Conceptos sin explosion de insumos");
+  if (k < 0) throw new Error("el PDF no trae la tabla de conceptos sin explosion");
+  sin.forEach((p) => {
